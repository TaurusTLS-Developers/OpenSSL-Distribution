; OpenSSL {{VERSION}} Multi-Architecture Windows Installer (Runtime Only)
[Setup]
AppId={{APP_ID}}
AppName=OpenSSL {{VERSION}}
AppVersion={{VERSION}}
AppVerName=OpenSSL {{VERSION}}
AppPublisher={{APP_PUBLISHER}}
AppPublisherURL={{APP_PUBLISHER_URL}}
VersionInfoVersion={{VERSION}}
DefaultDirName={autopf}\{{PUBLISHER_DISPLAY_NAME}}\OpenSSL-{{VERSION}}
DefaultGroupName=OpenSSL {{VERSION}}
AllowNoIcons=yes
OutputDir={{OUTPUT_DIR}}
OutputBaseFilename={{OUTPUT_BASE_FILENAME}}
Compression=lzma2/ultra64
SolidCompression=yes
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=commandline dialog
DisableProgramGroupPage=yes
WizardStyle=modern
ArchitecturesInstallIn64BitMode=x64compatible arm64

[Types]
Name: "standard"; Description: "Standard Installation"

[Components]
Name: "native";    Description: "Native OpenSSL Runtime (64-bit on x64/ARM64, 32-bit on x86)"; Types: standard; Flags: fixed
Name: "x86compat"; Description: "32-bit (x86) Compatibility Runtime (installs to %ProgramFiles(x86)%)"; Check: Is64BitInstallMode

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: addtopath; Description: "Add OpenSSL directory to system &PATH"; Components: native

[Files]
; License
Source: "{{REDIST_DIR}}\LICENSE.txt"; DestDir: "{app}"; Flags: ignoreversion

; --- Native x86 Files (installed to %ProgramFiles%\OpenSSL-{version} on 32-bit Windows OS) ---
Source: "{{REDIST_DIR}}\x86\openssl.exe"; DestDir: "{app}"; Flags: ignoreversion; Components: native; Check: not Is64BitInstallMode
Source: "{{REDIST_DIR}}\x86\libcrypto-*.dll"; DestDir: "{app}"; Flags: ignoreversion; Components: native; Check: not Is64BitInstallMode
Source: "{{REDIST_DIR}}\x86\libssl-*.dll"; DestDir: "{app}"; Flags: ignoreversion; Components: native; Check: not Is64BitInstallMode
Source: "{{REDIST_DIR}}\x86\providers\*.dll"; DestDir: "{app}\providers"; Flags: ignoreversion skipifsourcedoesntexist; Components: native; Check: not Is64BitInstallMode
Source: "{{REDIST_DIR}}\x86\engines\*.dll"; DestDir: "{app}\engines"; Flags: ignoreversion skipifsourcedoesntexist; Components: native; Check: not Is64BitInstallMode

; --- Native x64 Files (installed to %ProgramFiles%\OpenSSL-{version} on 64-bit x64 Windows OS) ---
Source: "{{REDIST_DIR}}\x64\openssl.exe"; DestDir: "{app}"; Flags: ignoreversion; Components: native; Check: IsX64
Source: "{{REDIST_DIR}}\x64\libcrypto-*.dll"; DestDir: "{app}"; Flags: ignoreversion; Components: native; Check: IsX64
Source: "{{REDIST_DIR}}\x64\libssl-*.dll"; DestDir: "{app}"; Flags: ignoreversion; Components: native; Check: IsX64
Source: "{{REDIST_DIR}}\x64\providers\*.dll"; DestDir: "{app}\providers"; Flags: ignoreversion skipifsourcedoesntexist; Components: native; Check: IsX64
Source: "{{REDIST_DIR}}\x64\engines\*.dll"; DestDir: "{app}\engines"; Flags: ignoreversion skipifsourcedoesntexist; Components: native; Check: IsX64

; --- Native ARM64EC Files (installed to %ProgramFiles%\OpenSSL-{version} on 64-bit ARM64 Windows OS) ---
Source: "{{REDIST_DIR}}\arm64ec\openssl.exe"; DestDir: "{app}"; Flags: ignoreversion; Components: native; Check: IsARM64
Source: "{{REDIST_DIR}}\arm64ec\libcrypto-*.dll"; DestDir: "{app}"; Flags: ignoreversion; Components: native; Check: IsARM64
Source: "{{REDIST_DIR}}\arm64ec\libssl-*.dll"; DestDir: "{app}"; Flags: ignoreversion; Components: native; Check: IsARM64
Source: "{{REDIST_DIR}}\arm64ec\providers\*.dll"; DestDir: "{app}\providers"; Flags: ignoreversion skipifsourcedoesntexist; Components: native; Check: IsARM64
Source: "{{REDIST_DIR}}\arm64ec\engines\*.dll"; DestDir: "{app}\engines"; Flags: ignoreversion skipifsourcedoesntexist; Components: native; Check: IsARM64

; --- 32-bit (x86) Compatibility Files (installed to %ProgramFiles(x86)%\OpenSSL-{version} on 64-bit Windows OS) ---
Source: "{{REDIST_DIR}}\x86\openssl.exe"; DestDir: "{autopf32}\OpenSSL-{{VERSION}}"; Flags: ignoreversion; Components: x86compat; Check: Is64BitInstallMode
Source: "{{REDIST_DIR}}\x86\libcrypto-*.dll"; DestDir: "{autopf32}\OpenSSL-{{VERSION}}"; Flags: ignoreversion; Components: x86compat; Check: Is64BitInstallMode
Source: "{{REDIST_DIR}}\x86\libssl-*.dll"; DestDir: "{autopf32}\OpenSSL-{{VERSION}}"; Flags: ignoreversion; Components: x86compat; Check: Is64BitInstallMode
Source: "{{REDIST_DIR}}\x86\providers\*.dll"; DestDir: "{autopf32}\OpenSSL-{{VERSION}}\providers"; Flags: ignoreversion skipifsourcedoesntexist; Components: x86compat; Check: Is64BitInstallMode
Source: "{{REDIST_DIR}}\x86\engines\*.dll"; DestDir: "{autopf32}\OpenSSL-{{VERSION}}\engines"; Flags: ignoreversion skipifsourcedoesntexist; Components: x86compat; Check: Is64BitInstallMode

[Icons]
Name: "{group}\OpenSSL {{VERSION}}"; Filename: "{app}\openssl.exe"
Name: "{group}\Uninstall OpenSSL {{VERSION}}"; Filename: "{uninstallexe}"

[Code]
procedure AddToPath(Dir: string; Machine: Boolean);
var RegPath, Path: string; RootKey: Integer;
begin
  if Machine then begin
    RootKey := HKEY_LOCAL_MACHINE;
    RegPath := 'SYSTEM\CurrentControlSet\Control\Session Manager\Environment';
  end else begin
    RootKey := HKEY_CURRENT_USER;
    RegPath := 'Environment';
  end;
  if not RegQueryStringValue(RootKey, RegPath, 'Path', Path) then Path := '';
  if Pos(LowerCase(Dir), LowerCase(Path)) = 0 then begin
    if (Length(Path) > 0) and (Path[Length(Path)] <> ';') then
      Path := Path + ';';
    RegWriteStringValue(RootKey, RegPath, 'Path', Path + Dir);
  end;
end;

procedure RemoveFromPath(Dir: string; Machine: Boolean);
var RegPath, Path: string; RootKey, P: Integer;
begin
  if Machine then begin
    RootKey := HKEY_LOCAL_MACHINE;
    RegPath := 'SYSTEM\CurrentControlSet\Control\Session Manager\Environment';
  end else begin
    RootKey := HKEY_CURRENT_USER;
    RegPath := 'Environment';
  end;
  if not RegQueryStringValue(RootKey, RegPath, 'Path', Path) then Exit;
  P := Pos(';' + Dir, Path);
  if P > 0 then begin
    Delete(Path, P, 1 + Length(Dir));
    RegWriteStringValue(RootKey, RegPath, 'Path', Path); Exit;
  end;
  P := Pos(Dir + ';', Path);
  if P > 0 then begin
    Delete(Path, P, Length(Dir) + 1);
    RegWriteStringValue(RootKey, RegPath, 'Path', Path);
  end;
end;

procedure CurStepChanged(CurStep: TSetupStep);
begin
  if (CurStep = ssPostInstall) and IsTaskSelected('addtopath') then
    AddToPath(ExpandConstant('{app}'), IsAdminInstallMode);
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  if CurUninstallStep = usPostUninstall then begin
    RemoveFromPath(ExpandConstant('{app}'), True);
    RemoveFromPath(ExpandConstant('{app}'), False);
  end;
end;